# Enable runtime PM on Thunderbolt / USB4 controllers (PCIe root ports, NHI, USB).
# Some firmware leaves these at control=on (always active), drawing ~1-2W at idle
# with nothing connected. Setting auto lets them suspend when unused.
#
# Matched by PCI database name rather than device ID so it covers every generation:
# Intel integrated TB (Ice Lake and newer), discrete Intel TB controllers, AMD USB4.
ACTION=="add", SUBSYSTEM=="pci", IMPORT{builtin}="hwdb --subsystem=pci"
ACTION=="add", SUBSYSTEM=="pci", ENV{ID_MODEL_FROM_DATABASE}=="*Thunderbolt*|*USB4*", ATTR{power/control}="auto"
