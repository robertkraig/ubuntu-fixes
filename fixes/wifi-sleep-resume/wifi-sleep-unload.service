[Unit]
Description=Unload __MODULE__ before sleep, reload after resume (WiFi resume hang workaround)
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
# rmmod loop instead of modprobe -r: Ubuntu's /etc/modprobe.d/iwlwifi.conf has a custom
# remove rule that unloads holders itself, causing modprobe -r to fail on the second name.
# ExecStart must exit 0 or systemd skips ExecStop on resume, leaving the module unloaded.
ExecStart=/bin/sh -c 'for m in __HOLDERS____MODULE__; do grep -q "^$m " /proc/modules && /usr/sbin/rmmod $m; done; sleep 1; exit 0'
ExecStop=/usr/sbin/modprobe __MODULE__

[Install]
WantedBy=sleep.target
